---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { getRelativeLocaleUrl } from 'astro:i18n';

// Import necessary images
import blueprints from "@images/blueprints-image.avif";
import personWorking from "@images/person-working.avif";
import beforeAfter from "@images/before-after.avif";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/using-tools.avif";
import progressBuilding from "@images/progress-building.avif";
import underConstruction from "@images/under-construction.avif";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Oferecendo Orientação Especializada",
    subTitle:
      "Iniciar um projeto pode ser desafiador. Com nossos serviços de consultoria profissional, guiamos você em cada etapa, garantindo que tome decisões bem informadas. Seja você um entusiasta ou um profissional experiente, nossos especialistas estão disponíveis para oferecer conselhos personalizados sobre seleção de recursos, escopo do projeto e conformidade com as diretrizes locais.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Plantas e tablet com planos de projeto.",
    imgTwo: personWorking,
    imgTwoAlt: "Pessoa trabalhando no escritório",
  },
  {
    isRightSection: false,
    title: "Transformando Ideias em Realidade",
    subTitle:
      "Nossa equipe qualificada traz precisão e excelência para cada projeto. Das implementações menores às estruturais, o RotaryDEV Fellowship oferece serviços confiáveis para concretizar seus planos. Garantimos os mais altos padrões de segurança e qualidade, utilizando as melhores ferramentas e metodologias disponíveis.",
    img: beforeAfter,
    imgAlt: "Projeto antes e depois",
    btnExists: true,
    btnTitle: "Saiba Mais",
    btnURL: "#",
  },
  {
    isRightSection: true,
    title: "Gerenciando Projetos com Supervisão Profissional",
    subTitle:
      "Uma gestão de projeto eficaz é o coração de qualquer iniciativa bem-sucedida. O RotaryDEV Fellowship oferece planejamento minucioso e serviços robustos de gestão que mantêm seu projeto no prazo e dentro do orçamento. Deixe-nos cuidar das complexidades de coordenação, alocação de recursos e comunicação enquanto você foca na sua visão.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Equipe orquestrando um projeto",
    imgTwo: aerialView,
    imgTwoAlt: "Visão geral de um projeto gerenciado",
  },
  {
    isRightSection: false,
    title: "Garantindo Desempenho Duradouro",
    subTitle:
      "Nosso compromisso com seu projeto não termina na entrega. O RotaryDEV Fellowship oferece serviços contínuos de manutenção e suporte para garantir a longevidade e o desempenho de suas soluções. De verificações regulares a assistência emergencial, nossa equipe responsiva está pronta para oferecer suporte sem interrupções.",
    img: usingTools,
    imgAlt:
      "Pessoa utilizando ferramentas de desenvolvimento",
  },
  {
    isRightSection: true,
    title: "Criando Estratégias Personalizadas para Desafios Únicos",
    subTitle:
      "Para nossos clientes de maior escala, o RotaryDEV Fellowship oferece soluções customizadas projetadas para atender desafios específicos. Ao entender suas necessidades únicas, desenvolvemos estratégias sob medida voltadas a otimizar suas operações, aumentar a eficiência e impulsionar seus resultados.",
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: "Estrutura de projeto em andamento",
    imgTwo: underConstruction,
    imgTwoAlt: "Projeto em fase de desenvolvimento",
    btnExists: true,
    btnTitle: "Leia mais",
    btnURL: "#",
  },
];

const pageTitle: string = `Serviços | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  lang="pt-BR"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://rotary-dev-fellowship.pages.dev/pt/services",
    url: "https://rotary-dev-fellowship.pages.dev/pt/services",
    name: "Serviços | RotaryDEV Fellowship",
    description:
      "Unindo expertise à sua visão, o RotaryDEV Fellowship oferece serviços excepcionais e soluções abrangentes em tecnologia, desde a consultoria até a conclusão do projeto.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://rotary-dev-fellowship.pages.dev",
      name: "RotaryDEV Fellowship",
      description:
        "A comunidade onde inovadores em tecnologia do Rotary International se reúnem para transformar ideias em soluções concretas.",
    },
    inLanguage: "pt-BR",
  }}
>
  <!--MainSection is the introductory section of the page, it also contains a CTA button-->
  <MainSection
    title="Unindo Expertise à Sua Visão"
    subTitle="No RotaryDEV Fellowship, temos orgulho de oferecer soluções abrangentes e serviço excepcional. Nossa equipe experiente está dedicada a apoiar seu projeto do início ao fim com uma gama de serviços especializados."
    btnExists={true}
    btnTitle="Agende uma Consulta"
    btnURL={getRelativeLocaleUrl("pt", "#")}
  />
  <!-- RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  -->
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  <!--FeaturesStats section showcases essential stats valuable to users-->
  <FeaturesStats
    title="Em Números"
    subTitle="Nosso compromisso com a qualidade e confiabilidade é evidente em cada projeto que realizamos. No RotaryDEV Fellowship, dedicamo-nos a entregar serviços de excelência que garantem soluções duradouras."
    mainStatTitle="96%"
    mainStatSubTitle="dos nossos membros avaliam sua experiência como excepcional"
    stats={[
      {
        stat: "99,8%",
        description: "taxa de conclusão de projetos",
      },
      {
        stat: "5.000+",
        description: "contribuições realizadas",
      },
      {
        stat: "85%",
        description: "crescimento de membros ano a ano",
      },
    ]}
  />
</MainLayout>
