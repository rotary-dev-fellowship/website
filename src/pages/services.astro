---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import blueprints from "@images/blueprints-image.avif";
import personWorking from "@images/person-working.avif";
import beforeAfter from "@images/before-after.avif";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/using-tools.avif";
import progressBuilding from "@images/progress-building.avif";
import underConstruction from "@images/under-construction.avif";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Delivering Expert Guidance",
    subTitle:
      "Starting a project can be overwhelming. With our professional consultation services, we guide you through every stage so you can make well-informed decisions. Whether you are a hobbyist or an experienced professional, our experts are on hand to offer tailored advice on resource selection, project scope, and compliance with local guidelines.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Blueprints and a tablet showing project plans.",
    imgTwo: personWorking,
    imgTwoAlt: "Person working in the office",
  },
  {
    isRightSection: false,
    title: "Turning Ideas into Reality",
    subTitle:
      "Our skilled team brings precision and excellence to every project. From small implementations to structural work, the RotaryDEV Fellowship offers reliable services to bring your plans to life. We uphold the highest standards of quality, using the best tools and methodologies available.",
    img: beforeAfter,
    imgAlt: "A project before and after",
    btnExists: true,
    btnTitle: "Learn More",
    btnURL: "#",
  },
  {
    isRightSection: true,
    title: "Navigating Projects with Professional Oversight",
    subTitle:
      "Effective project management is at the heart of any successful initiative. The RotaryDEV Fellowship provides thorough planning and robust management services that keep your project on time and within budget. Let us handle the complexities of coordination, resource allocation, and communication while you focus on your vision.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "A team orchestrating a project",
    imgTwo: aerialView,
    imgTwoAlt: "Overview of a managed project",
  },
  {
    isRightSection: false,
    title: "Ensuring Long-lasting Performance",
    subTitle:
      "Our commitment to your project doesn't end at delivery. The RotaryDEV Fellowship offers ongoing maintenance and support services to ensure the longevity and performance of your solutions. From regular check-ins to urgent assistance, our team is always available.",
    img: usingTools,
    imgAlt: "Person using development tools",
  },
  {
    isRightSection: true,
    title: "Crafting Bespoke Strategies for Unique Challenges",
    subTitle:
      "For larger-scale partners, the RotaryDEV Fellowship offers custom solutions designed to meet specific challenges. By understanding your unique needs, we develop tailored strategies aimed at optimizing your operations, improving efficiency, and driving your results.",
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: "A project structure in progress",
    imgTwo: underConstruction,
    imgTwoAlt: "A project in the build phase",
    btnExists: true,
    btnTitle: "Read more",
    btnURL: "#",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://rotary-dev-fellowship.pages.dev/services",
    "url": "https://rotary-dev-fellowship.pages.dev/services",
    "name": "Services | RotaryDEV Fellowship",
    "description": "Uniting expertise with your vision, the RotaryDEV Fellowship offers exceptional service and comprehensive solutions in technology, from consultation to project completion.",
    "isPartOf": {
        "@type": "WebSite",
        "url": "https://rotary-dev-fellowship.pages.dev",
        "name": "RotaryDEV Fellowship",
        "description": "The community where tech innovators of Rotary International come together to turn ideas into tangible solutions."
    },
    "inLanguage": "en-US"
  }}
>
  <!--MainSection is the introductory section of the page, it also contains a CTA button-->
  <MainSection
    title="Uniting Expertise with Your Vision"
    subTitle="At the RotaryDEV Fellowship, we take pride in offering comprehensive solutions and exceptional service. Our experienced team is dedicated to supporting your project from start to finish with a range of specialized services."
    btnExists={true}
    btnTitle="Request a Consultation"
    btnURL="#"
  />
  <!-- RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  -->
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  <!--FeaturesStats section showcases essential stats valuable to users-->
  <FeaturesStats
    title="By the Numbers"
    subTitle="Our commitment to quality and reliability shows in every project we take on. At the RotaryDEV Fellowship, we are dedicated to delivering services of excellence that ensure long-lasting solutions."
    mainStatTitle="96%"
    mainStatSubTitle="of our members rate their experience as exceptional"
    stats={[
      {
        stat: "99.8%",
        description: "project completion rate",
      },
      {
        stat: "5,000+",
        description: "contributions made",
      },
      {
        stat: "85%",
        description: "member growth year-over-year",
      },
    ]}
  />
</MainLayout>
