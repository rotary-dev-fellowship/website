---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import ContactSection from "@components/sections/ContactSection.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `Contact | ${SITE.title}`;
---

<!--Utilizing MainLayout for the outer layout of the page, and defining meta for SEO purposes-->
<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://rotary-dev-fellowship.pages.dev/contact",
    "url": "https://rotary-dev-fellowship.pages.dev/contact",
    "name": "Contact Us | RotaryDEV Fellowship",
    "description":
      "Have questions or want to discuss a project? Reach out and we'll find the right solution together.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://rotary-dev-fellowship.pages.dev",
      "name": "RotaryDEV Fellowship",
      "description":
        "The community where tech innovators of Rotary International come together to turn ideas into tangible solutions.",
    },
    "inLanguage": "en-US"
  }}
>
  <ContactSection />
</MainLayout>
