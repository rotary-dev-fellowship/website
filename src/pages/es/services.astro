---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import { getRelativeLocaleUrl } from 'astro:i18n';

// Import necessary images
import blueprints from "@images/blueprints-image.avif";
import personWorking from "@images/person-working.avif";
import beforeAfter from "@images/before-after.avif";
import constructionWorkers from "@images/construction-workers.avif";
import aerialView from "@images/aerial-view.avif";
import usingTools from "@images/using-tools.avif";
import progressBuilding from "@images/progress-building.avif";
import underConstruction from "@images/under-construction.avif";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Orientación experta en cada paso",
    subTitle:
      "Iniciar un proyecto puede resultar abrumador. Con nuestros servicios de consultoría profesional, te acompañamos en cada etapa para que tomes decisiones bien fundamentadas. Tanto si eres un entusiasta del bricolaje como un profesional experimentado, nuestros expertos están disponibles para ofrecerte asesoramiento personalizado sobre selección de recursos, alcance del proyecto y cumplimiento de las directrices locales.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Planos y tablet con planes de proyecto.",
    imgTwo: personWorking,
    imgTwoAlt: "Persona trabajando en la oficina",
  },
  {
    isRightSection: false,
    title: "Transformando ideas en realidad",
    subTitle:
      "Nuestro equipo cualificado aporta precisión y excelencia a cada proyecto. Desde implementaciones menores hasta estructurales, el RotaryDEV Fellowship ofrece servicios fiables para materializar tus planes. Garantizamos los más altos estándares de calidad, utilizando las mejores herramientas y metodologías disponibles.",
    img: beforeAfter,
    imgAlt: "Proyecto antes y después",
    btnExists: true,
    btnTitle: "Saber más",
    btnURL: "#",
  },
  {
    isRightSection: true,
    title: "Gestión de proyectos con supervisión profesional",
    subTitle:
      "Una gestión eficaz del proyecto es el núcleo de cualquier iniciativa exitosa. El RotaryDEV Fellowship ofrece planificación minuciosa y servicios sólidos de gestión que mantienen tu proyecto en plazo y dentro del presupuesto. Déjanos gestionar la coordinación, la asignación de recursos y la comunicación mientras tú te centras en tu visión.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Equipo gestionando un proyecto",
    imgTwo: aerialView,
    imgTwoAlt: "Vista general de un proyecto gestionado",
  },
  {
    isRightSection: false,
    title: "Garantizando un rendimiento duradero",
    subTitle:
      "Nuestro compromiso con tu proyecto no termina en la entrega. El RotaryDEV Fellowship ofrece servicios continuos de mantenimiento y soporte para garantizar la longevidad y el rendimiento de tus soluciones. Desde revisiones periódicas hasta asistencia de urgencia, nuestro equipo está siempre disponible.",
    img: usingTools,
    imgAlt:
      "Persona utilizando herramientas de desarrollo",
  },
  {
    isRightSection: true,
    title: "Estrategias personalizadas para retos únicos",
    subTitle:
      "Para nuestros clientes de mayor envergadura, el RotaryDEV Fellowship ofrece soluciones a medida diseñadas para afrontar retos específicos. Al comprender tus necesidades únicas, desarrollamos estrategias personalizadas orientadas a optimizar tus operaciones, mejorar la eficiencia e impulsar tus resultados.",
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: "Estructura de proyecto en desarrollo",
    imgTwo: underConstruction,
    imgTwoAlt: "Proyecto en fase de construcción",
    btnExists: true,
    btnTitle: "Leer más",
    btnURL: "#",
  },
];

const pageTitle: string = `Servicios | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  lang="es"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://rotary-dev-fellowship.pages.dev/es/services",
    url: "https://rotary-dev-fellowship.pages.dev/es/services",
    name: "Servicios | RotaryDEV Fellowship",
    description:
      "Uniendo experiencia con tu visión, el RotaryDEV Fellowship ofrece servicios excepcionales y soluciones integrales en tecnología, desde la consultoría hasta la finalización del proyecto.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://rotary-dev-fellowship.pages.dev",
      name: "RotaryDEV Fellowship",
      description:
        "La comunidad donde los innovadores tecnológicos de Rotary International se unen para transformar ideas en soluciones tangibles.",
    },
    inLanguage: "es-ES",
  }}
>
  <MainSection
    title="Uniendo experiencia con tu visión"
    subTitle="En el RotaryDEV Fellowship nos enorgullece ofrecer soluciones integrales y un servicio excepcional. Nuestro equipo experimentado está dedicado a apoyar tu proyecto de principio a fin con una gama de servicios especializados."
    btnExists={true}
    btnTitle="Solicitar consulta"
    btnURL={getRelativeLocaleUrl("es", "#")}
  />
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  <FeaturesStats
    title="En cifras"
    subTitle="Nuestro compromiso con la calidad y la fiabilidad es evidente en cada proyecto que realizamos. En el RotaryDEV Fellowship nos dedicamos a ofrecer servicios de excelencia que garantizan soluciones duraderas."
    mainStatTitle="96%"
    mainStatSubTitle="de nuestros miembros valoran su experiencia como excepcional"
    stats={[
      {
        stat: "99,8%",
        description: "tasa de finalización de proyectos",
      },
      {
        stat: "5.000+",
        description: "contribuciones realizadas",
      },
      {
        stat: "85%",
        description: "crecimiento de miembros año a año",
      },
    ]}
  />
</MainLayout>
