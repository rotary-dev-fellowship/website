---
import { type CollectionEntry, getCollection } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import MemberProfile from "@/components/sections/members/MemberProfile.astro";
import { memberProfileLabels } from "@/i18n/memberProfileLabels";
import { SITE } from "@/data_files/constants";

export async function getStaticPaths() {
  const members = await getCollection("members");
  const blogPosts = await getCollection("blog");

  return members
    .filter((member) => member.data.active)
    .map((member) => ({
      params: { slug: member.slug },
      props: {
        member,
        posts: blogPosts.filter((post) => post.data.author === member.data.name),
      },
    }));
}

type Props = {
  member: CollectionEntry<"members">;
  posts: CollectionEntry<"blog">[];
};

const { member, posts } = Astro.props;
const labels = memberProfileLabels.es;
const pageTitle = `${member.data.name} | ${SITE.title}`;
const pageUrl = `${SITE.url}/es/members/${member.slug}`;
---

<MainLayout
  title={pageTitle}
  meta={member.data.bio}
  lang="es"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": pageUrl,
    url: pageUrl,
    name: pageTitle,
    description: member.data.bio,
    about: {
      "@type": "Person",
      name: member.data.name,
      description: member.data.bio,
    },
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: SITE.title,
      description: SITE.description_short,
    },
    inLanguage: "es-ES",
  }}
>
  <MemberProfile
    member={member}
    labels={labels}
    posts={posts}
    membersBasePath="/es/members"
  />
</MainLayout>
